{
  "name": "react-chemlab",
  "version": "1.0.0",
  "description": "Textbook-grade chemistry & physics apparatus, circuit, optics, and reaction visualizers for React",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/adhil72/react-chemlab.git"
  },
  "keywords": [
    "chemistry",
    "physics",
    "circuits",
    "science",
    "visualizer",
    "react",
    "svg",
    "stem",
    "education",
    "galvanic-cell",
    "titration",
    "spectrophotometer",
    "wheatstone-bridge",
    "logic-gates",
    "ray-optics",
    "pendulum"
  ],
  "author": "adhil72",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:app": "tsc -b && vite build",
    "build:lib": "rm -rf dist && tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "build": "npm run build:lib",
    "lint": "oxlint",
    "preview": "vite preview",
    "prepublishOnly": "npm run build:lib"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-plugin": "^1.168.47",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
